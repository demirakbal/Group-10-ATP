  <linkShapes>
    <shape name="default" curviness="0.0">
      <lines>
        <line x="-0.2" visible="false">
          <dash value="0.0"></dash>
          <dash value="1.0"></dash>
        </line>
        <line x="0.0" visible="true">
          <dash value="1.0"></dash>
          <dash value="0.0"></dash>
        </line>
        <line x="0.2" visible="false">
          <dash value="0.0"></dash>
          <dash value="1.0"></dash>
        </line>
      </lines>
      <indicator>
        <shape name="link direction" rotatable="true" editableColorIndex="0">
          <line endX="90" startY="150" marked="true" color="-1920102913" endY="180" startX="150"></line>
          <line endX="210" startY="150" marked="true" color="-1920102913" endY="180" startX="150"></line>
        </shape>
      </indicator>
    </shape>
  </linkShapes>
  <previewCommands>setup repeat 75 [ go ]</previewCommands>
  <experiments>
    <experiment name="task-difficulty-40" repetitions="30" sequentialRunOrder="true" runMetricsEveryStep="false" timeLimit="3000">
      <setup>random-seed (200000 + behaviorspace-run-number) setup set run-length 3000</setup>
      <go>go</go>
      <metrics>
        <metric>mean-skill</metric>
        <metric>mean-trust</metric>
        <metric>mean-delegation</metric>
        <metric>mean-quality</metric>
        <metric>mean-duration</metric>
        <metric>mean-observed-duration</metric>
        <metric>mean-learning</metric>
        <metric>mean-erosion</metric>
        <metric>mean-tasks</metric>
        <metric>group-mean-skill 0</metric>
        <metric>group-skill-change 0</metric>
        <metric>group-mean-deleg 0</metric>
        <metric>group-bench-change 0</metric>
        <metric>group-benchmark 0 40</metric>
        <metric>group-benchmark-change 0 40</metric>
        <metric>group-benchmark 0 55</metric>
        <metric>group-benchmark-change 0 55</metric>
        <metric>group-benchmark 0 70</metric>
        <metric>group-benchmark-change 0 70</metric>
        <metric>group-mean-skill 1</metric>
        <metric>group-skill-change 1</metric>
        <metric>group-mean-deleg 1</metric>
        <metric>group-bench-change 1</metric>
        <metric>group-benchmark 1 40</metric>
        <metric>group-benchmark-change 1 40</metric>
        <metric>group-benchmark 1 55</metric>
        <metric>group-benchmark-change 1 55</metric>
        <metric>group-benchmark 1 70</metric>
        <metric>group-benchmark-change 1 70</metric>
        <metric>group-mean-skill 2</metric>
        <metric>group-skill-change 2</metric>
        <metric>group-mean-deleg 2</metric>
        <metric>group-bench-change 2</metric>
        <metric>group-benchmark 2 40</metric>
        <metric>group-benchmark-change 2 40</metric>
        <metric>group-benchmark 2 55</metric>
        <metric>group-benchmark-change 2 55</metric>
        <metric>group-benchmark 2 70</metric>
        <metric>group-benchmark-change 2 70</metric>
        <metric>mean [skill - initial-skill] of humans</metric>
        <metric>mean [initial-skill] of humans</metric>
        <metric>percent-skill-loss humans 0</metric>
        <metric>percent-skill-loss humans 5</metric>
        <metric>skill-sd humans</metric>
        <metric>recent-delegation humans</metric>
        <metric>recent-learning humans</metric>
        <metric>recent-erosion humans</metric>
        <metric>sum [length recent-task-records] of humans</metric>
        <metric>count humans with [not empty? recent-task-records]</metric>
        <metric>mean [quality-curve skill 40] of humans</metric>
        <metric>mean [quality-curve skill 55] of humans</metric>
        <metric>mean [quality-curve skill 70] of humans</metric>
        <metric>percent-skill-loss (humans with [skill-group = 0]) 0</metric>
        <metric>percent-skill-loss (humans with [skill-group = 0]) 5</metric>
        <metric>skill-sd (humans with [skill-group = 0])</metric>
