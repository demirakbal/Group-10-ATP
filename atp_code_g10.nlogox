  <linkShapes>
    <shape name="default" curviness="0.0">
      <lines>
        <line x="-0.2" visible="false">
          <dash value="0.0"></dash>
          <dash value="1.0"></dash>
        </line>
        <line x="0.0" visible="true">
          <dash value="1.0"></dash>
          <dash value="0.0"></dash>
        </line>
        <line x="0.2" visible="false">
          <dash value="0.0"></dash>
          <dash value="1.0"></dash>
        </line>
      </lines>
      <indicator>
        <shape name="link direction" rotatable="true" editableColorIndex="0">
          <line endX="90" startY="150" marked="true" color="-1920102913" endY="180" startX="150"></line>
          <line endX="210" startY="150" marked="true" color="-1920102913" endY="180" startX="150"></line>
        </shape>
      </indicator>
    </shape>
  </linkShapes>
  <previewCommands>setup repeat 75 [ go ]</previewCommands>
  <experiments>
    <experiment name="main-experiment" repetitions="20" sequentialRunOrder="true" runMetricsEveryStep="false" timeLimit="700">
      <setup>setup</setup>
      <go>go</go>
      <metrics>
        <metric>run-seed</metric>
        <metric>mean [skill - initial-skill] of humans</metric>
        <metric>mean-delegation</metric>
        <metric>group-skill-change 0</metric>
        <metric>group-mean-deleg 0</metric>
        <metric>group-skill-change 1</metric>
        <metric>group-mean-deleg 1</metric>
        <metric>group-skill-change 2</metric>
        <metric>group-mean-deleg 2</metric>
        <metric>mean [initial-skill] of humans with [skill-group = 0]</metric>
        <metric>mean [initial-skill] of humans with [skill-group = 1]</metric>
        <metric>mean [initial-skill] of humans with [skill-group = 2]</metric>
      </metrics>
      <constants>
        <enumeratedValueSet variable="mu-skill">
          <value value="0"></value>
          <value value="10"></value>
          <value value="20"></value>
          <value value="30"></value>
          <value value="40"></value>
          <value value="50"></value>
          <value value="60"></value>
          <value value="70"></value>
          <value value="80"></value>
          <value value="90"></value>
          <value value="100"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="ai-capability">
          <value value="0"></value>
          <value value="10"></value>
          <value value="20"></value>
          <value value="30"></value>
          <value value="40"></value>
          <value value="50"></value>
          <value value="60"></value>
          <value value="70"></value>
          <value value="80"></value>
          <value value="90"></value>
          <value value="100"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="lambda-peer">
          <value value="0"></value>
          <value value="0.04"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="mu-diff">
          <value value="55"></value>
        </enumeratedValueSet>
      </constants>
    </experiment>
    <experiment name="skill-delegation-trajectories" repetitions="12" sequentialRunOrder="true" runMetricsEveryStep="true" timeLimit="700">
      <setup>setup</setup>
      <go>go</go>
      <metrics>
        <metric>run-seed</metric>
        <metric>mean-skill</metric>
        <metric>mean [previous-delegation] of humans</metric>
        <metric>group-mean-skill 0</metric>
        <metric>mean [previous-delegation] of humans with [skill-group = 0]</metric>
        <metric>mean [initial-skill] of humans with [skill-group = 0]</metric>
        <metric>group-mean-skill 1</metric>
        <metric>mean [previous-delegation] of humans with [skill-group = 1]</metric>
        <metric>mean [initial-skill] of humans with [skill-group = 1]</metric>
        <metric>group-mean-skill 2</metric>
        <metric>mean [previous-delegation] of humans with [skill-group = 2]</metric>
        <metric>mean [initial-skill] of humans with [skill-group = 2]</metric>
      </metrics>
      <constants>
        <enumeratedValueSet variable="mu-skill">
          <value value="50"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="ai-capability">
          <value value="20"></value>
          <value value="50"></value>
          <value value="70"></value>
          <value value="90"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="lambda-peer">
          <value value="0"></value>
          <value value="0.04"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="mu-diff">
          <value value="55"></value>
        </enumeratedValueSet>
      </constants>
    </experiment>
  </experiments>
</model>
