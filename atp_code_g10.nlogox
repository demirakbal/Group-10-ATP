    <plot x="830" autoPlotX="true" yMax="1.0" autoPlotY="false" yAxis="Delegated share" y="440" xMin="0.0" height="230" legend="true" xMax="700.0" yMin="0.0" width="400" xAxis="Rounds" display="Recent delegation by tertile (100 rounds)">
      <setup></setup>
