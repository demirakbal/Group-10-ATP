<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.4" snapToGrid="true">
  <code><![CDATA[;; ATP Group 10 - simplified report-aligned revision, NetLogo 7.0.4.
;; Original model preserved separately. No additional outcome or decision noise.
;; Toroidal stationary population; four global phases; fixed analysis tertiles.
;; Interface inputs survive setup and BehaviorSpace overrides. Other baselines
;; are centralized below. Blue shading reflects latest completed delegation.
;; Task records are available per human; their schema is documented in Info.

breed [humans human]

globals [
  n-humans
  ;; ai-capability, lambda-peer, mu-skill and mu-diff are interface inputs.
  ;; n-humans is fixed at 100 during setup.
  ;; population and initial conditions
  sd-skill mu-trust sd-trust mean-deleg-init concentration
  ;; task environment
  sd-diff sd-perception-skill sd-perception-difficulty gamma-trust
  ;; deterministic quality
  quality-slope q-min
  ;; duration and delegation decision
  base-time duration-reg
  w-quality w-time w-shortfall eta n-candidates
  ;; trust updating
  alpha-pos alpha-neg
  ;; skill development
  learn-rate challenge-width scaffold-kappa
  erosion-rate erosion-curvature h-max
  ;; experiment
  run-length benchmark-difficulties
]

humans-own [
  ;; state
  skill trust deleg-tend
  initial-skill skill-group          ;; group: 0 = low, 1 = medium, 2 = high
  latest-deleg n-tasks next-tendency
  ;; current task
  has-task? task-diff progress a-chosen
  exp-quality act-duration assignment-step observed-duration
  ;; benchmark (independent performance, no AI)
  bench-start
  ;; bookkeeping for supporting measurements
  sum-deleg sum-quality sum-duration sum-observed-duration sum-learn sum-erosion
  task-records ;; completed task records; see Info tab for columns
]

;; ----------------------------------------------------------------------------
;; PARAMETERS (Table 1 baseline). To vary a parameter in BehaviorSpace, make it
;; an interface input and remove its initialization here.
;; ----------------------------------------------------------------------------
to set-baseline-parameters
  set n-humans 100
  set sd-skill 15
  set mu-trust 50
  set sd-trust 15
  set mean-deleg-init 0.5
  set concentration 10

  set sd-diff 15
  set sd-perception-skill 1
  set sd-perception-difficulty 5
  set gamma-trust 0.30

  set quality-slope 12
  set q-min 50

  set base-time 10
  set duration-reg 20
  set w-quality 1.0
  set w-time 0.30
  set w-shortfall 1.50
  set eta 0.5
  set n-candidates 101     ;; 0, 0.01, ..., 1; first maximum breaks ties

  set alpha-pos 0.10
  set alpha-neg 0.20

  set learn-rate 2
  set challenge-width 25
  set scaffold-kappa 2
  set erosion-rate 1
  set erosion-curvature 2
  set h-max 100

  set run-length 3000
  set benchmark-difficulties [40 55 70]
end

;; ----------------------------------------------------------------------------
;; SETUP
;; ----------------------------------------------------------------------------
to setup
  clear-all
  set-baseline-parameters
  if n-humans < 3 or n-humans != floor n-humans [
    error "n-humans must be an integer of at least 3 for tertile analysis."
  ]
  if ai-capability < 0 or ai-capability > 100 [ error "AI capability must be in [0,100]." ]
  if lambda-peer < 0 or lambda-peer > 1 [ error "Peer influence must be in [0,1]." ]
  let side ceiling sqrt n-humans
  resize-world 0 (side - 1) 0 (side - 1)
  set-patch-size (400 / side)
  ask n-of n-humans patches [
    sprout-humans 1 [ init-human ]
  ]
  assign-skill-groups
  update-visuals
  reset-ticks
end

to init-human
  set skill random-trunc-normal mu-skill sd-skill
  set trust random-trunc-normal mu-trust sd-trust
  set deleg-tend random-beta (mean-deleg-init * concentration) ((1 - mean-deleg-init) * concentration)
  set initial-skill skill
  set latest-deleg false ;; no completed observation; n-tasks gates social eligibility
  set next-tendency deleg-tend
  set task-records []
  set n-tasks 0
  set has-task? false
  set task-diff 0
  set progress 0
  set a-chosen 0
  set exp-quality 0
  set assignment-step 0
  set observed-duration 0
  set act-duration 1
  set sum-deleg 0
  set sum-quality 0
  set sum-duration 0
  set sum-observed-duration 0
  set sum-learn 0
  set sum-erosion 0
  set bench-start benchmark-scores
  set shape "square"
  set size 0.9
end

;; tertiles of the realised initial skill distribution; used for analysis only
to assign-skill-groups
  ;; Stable identifier breaks equal-skill ties, as specified in the report.
  let sorted sort-by [[a b] -> ifelse-value ([skill] of a = [skill] of b)
    [[who] of a < [who] of b] [[skill] of a < [skill] of b]] humans
  (foreach sorted (range n-humans) [ [h i] ->
    ask h [ set skill-group floor (3 * i / n-humans) ]
  ])
end

;; ----------------------------------------------------------------------------
;; MAIN LOOP  (Algorithm 1; humans work asynchronously)
;; ----------------------------------------------------------------------------
to go
  if ticks >= run-length [ stop ]
  ;; Four global phases: no newly assigned task progresses in this step.
  ask humans with [has-task?] [ progress-task ]
  let completers humans with [has-task? and progress >= 1]
  ask completers [ complete-task ]
  ask completers [ calculate-social-influence ]
  ask completers [ set deleg-tend next-tendency ]
  ask humans with [not has-task?] [ start-task ]
  update-visuals
  tick
end

;; ----------------------------------------------------------------------------
;; TASK GENERATION, PERCEPTION AND DELEGATION DECISION
;; ----------------------------------------------------------------------------
to start-task
  set task-diff random-trunc-normal mu-diff sd-diff

  ;; temporary perceptions
  let h-hat clip (skill + random-normal 0 sd-perception-skill) 0 100
  let d-hat clip (task-diff + random-normal 0 sd-perception-difficulty) 0 100
  let a-hat clip (ai-capability + gamma-trust * (trust - 50)) 0 100

  ;; evaluate candidate delegation values
  let candidates n-values n-candidates [ i -> i / (n-candidates - 1) ]
  let utils map [ cand -> utility cand h-hat d-hat a-hat ] candidates
  let best-a item (position (max utils) utils) candidates

  ;; Blend the deterministic lowest-maximising target with persistent tendency.
  set a-chosen clip (deleg-tend + eta * (best-a - deleg-tend)) 0 1
  set exp-quality expected-quality a-chosen h-hat a-hat d-hat
  ;; actual duration uses true values and is fixed for the task
  set act-duration task-duration a-chosen skill ai-capability task-diff

  set assignment-step ticks
  set progress 0                ;; progress starts accumulating next tick
  set has-task? true
end

;; logistic competence curve
to-report quality-curve [cap diff]
  report 100 / (1 + exp ((diff - cap) / quality-slope))
end

;; expected quality for delegation a
to-report expected-quality [a h-cap a-cap diff]
  ;; Algebraically identical weighted average; preserves exact ties when capabilities match.
  let qh quality-curve h-cap diff
  report qh + a * ((quality-curve a-cap diff) - qh)
end

;; continuous task duration (used for perceived and actual values by passing in
;; perceived or true capabilities and difficulty)
to-report task-duration [a h-cap a-cap diff]
  let cap h-cap + a * (a-cap - h-cap)
  let ratio (diff + duration-reg) / (cap + duration-reg)
  report max (list 1 (base-time * ratio))
end

;; utility of a candidate delegation value
to-report utility [a h-hat d-hat a-hat]
  let q expected-quality a h-hat a-hat d-hat
  let tau0 task-duration 0 h-hat a-hat d-hat
  let tau  task-duration a h-hat a-hat d-hat
  let gain clip ((tau0 - tau) / tau0) -1 1
  let shortfall (max (list 0 (q-min - q))) / 100
  report (w-quality * q / 100) + (w-time * gain) - (w-shortfall * shortfall)
end

;; ----------------------------------------------------------------------------
;; TASK PROGRESS AND COMPLETION
;; ----------------------------------------------------------------------------
to progress-task
  ;; Equivalent to adding 1 / duration per step, without accumulated rounding drift.
  set progress (ticks - assignment-step) / act-duration

end

to complete-task
  let a a-chosen

  ;; Deterministic quality uses skill before the completion update.
  let qh quality-curve skill task-diff
  let qa quality-curve ai-capability task-diff
  let q-actual (1 - a) * qh + a * qa
  set observed-duration ticks - assignment-step
  ;; Quality-only trust update; available room depends on direction.
  if a > 0 [
    let evidence (q-actual - exp-quality) / 100
    ifelse evidence >= 0
      [ set trust trust + a * alpha-pos * evidence * (100 - trust) ]
      [ set trust trust + a * alpha-neg * evidence * trust ]
  ]

  ;; --- learning gain ---
  let c exp (-0.5 * ((task-diff - skill) / challenge-width) ^ 2)
  let p-indep 1 - a
  let s-scaf scaffold-kappa * a * (1 - a) * qa / 100
  let learn learn-rate * ((h-max - skill) / h-max) * c * (p-indep + s-scaf)

  ;; Erosion uses only this completed task, with pre-update skill.
  let erosion erosion-rate * (skill / h-max) * (a ^ erosion-curvature)
  let skill-before skill
  set latest-deleg a
  set n-tasks n-tasks + 1

  set skill clip (skill + learn - erosion) 0 h-max

  ;; --- bookkeeping ---
  set sum-deleg sum-deleg + a
  set sum-quality sum-quality + q-actual
  set sum-duration sum-duration + act-duration
  set sum-observed-duration sum-observed-duration + observed-duration
  set task-records lput (list assignment-step ticks task-diff a exp-quality q-actual act-duration observed-duration learn erosion skill-before skill trust deleg-tend) task-records
  set sum-learn sum-learn + learn
  set sum-erosion sum-erosion + erosion

  set has-task? false
  set progress 0
end

;; weak imitation of the eight surrounding locations
to calculate-social-influence
  set next-tendency deleg-tend
  let peers (humans-on neighbors) with [n-tasks > 0]
  if any? peers [
    let a-peer mean [latest-deleg] of peers
    set next-tendency clip (deleg-tend + lambda-peer * (a-peer - deleg-tend)) 0 1
  ]
end

;; ----------------------------------------------------------------------------
;; BENCHMARK: independent (no-AI) expected performance at fixed difficulties.
;; Deterministic and does not touch skill, trust or delegation.
;; ----------------------------------------------------------------------------
to-report benchmark-scores
  report map [ d -> quality-curve skill d ] benchmark-difficulties
end

;; ----------------------------------------------------------------------------
;; HELPERS
;; ----------------------------------------------------------------------------
to-report clip [x lo hi]
  report max (list lo (min (list hi x)))
end

;; truncated normal on [0,100] by redrawing
to-report random-trunc-normal [mu sd]
  let x random-normal mu sd
  while [x < 0 or x > 100] [ set x random-normal mu sd ]
  report x
end

;; Beta(a,b) via two gamma draws
to-report random-beta [a b]
  if a = 0 [ report 0 ]
  if b = 0 [ report 1 ]
  let x random-gamma a 1
  let y random-gamma b 1
  report x / (x + y)
end

to update-visuals
  ask humans [
    let d ifelse-value (n-tasks > 0) [latest-deleg] [deleg-tend]
    set color scale-color blue d -0.2 1.2     ;; lighter = more AI delegation
  ]
end

;; ----------------------------------------------------------------------------
;; REPORTERS (monitors, plots, BehaviorSpace)
;; ----------------------------------------------------------------------------
to-report mean-skill
  report mean [skill] of humans
end

to-report mean-trust
  report mean [trust] of humans
end

;; mean over humans of their average delegation across all completed tasks
to-report mean-delegation
  let hs humans with [n-tasks > 0]
  if not any? hs [ report 0 ]
  report mean [sum-deleg / n-tasks] of hs
end

to-report group-mean-deleg [g]
  let hs humans with [skill-group = g and n-tasks > 0]
  if not any? hs [ report 0 ]
  report mean [sum-deleg / n-tasks] of hs
end

to-report group-skill-change [g]
  report mean [skill - initial-skill] of humans with [skill-group = g]
end

;; change in mean independent benchmark performance (end minus start)
to-report group-bench-change [g]
  report mean [(mean benchmark-scores) - (mean bench-start)] of humans with [skill-group = g]
end

to-report mean-tasks
  report mean [n-tasks] of humans
end

to-report mean-quality
  let hs humans with [n-tasks > 0]
  if not any? hs [ report 0 ]
  report mean [sum-quality / n-tasks] of hs
end

to-report mean-duration
  let hs humans with [n-tasks > 0]
  if not any? hs [ report 0 ]
  report mean [sum-duration / n-tasks] of hs
end

to-report mean-learning
  let hs humans with [n-tasks > 0]
  if not any? hs [ report 0 ]
  report mean [sum-learn / n-tasks] of hs
end

to-report mean-erosion
  let hs humans with [n-tasks > 0]
  if not any? hs [ report 0 ]
  report mean [sum-erosion / n-tasks] of hs
end

;; Mean of each human's completed-task observed duration (whole steps).
to-report mean-observed-duration
  let hs humans with [n-tasks > 0]
  if not any? hs [ report 0 ]
  report mean [sum-observed-duration / n-tasks] of hs
end

;; Group states and per-difficulty independent assessments, analysis only.
to-report group-mean-skill [g]
  report mean [skill] of humans with [skill-group = g]
end

to-report group-benchmark [g difficulty]
  report mean [quality-curve skill difficulty] of humans with [skill-group = g]
end

to-report group-benchmark-change [g difficulty]
  let k position difficulty benchmark-difficulties
  report mean [(quality-curve skill difficulty) - item k bench-start] of humans with [skill-group = g]
end

;; Shared measurements. These reporters never mutate human state.
;; Record indices follow the completed-task schema documented in Info.
to-report record-completion-step [record]
  report item 1 record
end

to-report record-delegation [record]
  report item 3 record
end

to-report record-learning [record]
  report item 8 record
end

to-report record-erosion [record]
  report item 9 record
end

;; Human context; the window is [ticks - 100, ticks).
to-report recent-task-records
  report filter [record ->
    record-completion-step record >= ticks - 100 and
    record-completion-step record < ticks
  ] task-records
end

;; Keep both original agentset traversals, including their random-number use.
;; Average within each eligible human first, then across eligible humans.
to-report recent-task-mean [hs measure]
  let eligible filter [records -> not empty? records] ([recent-task-records] of hs)
  if empty? eligible [ report false ]
  let observations filter [records -> not empty? records] ([recent-task-records] of hs)
  report mean map [records -> mean map measure records] observations
end

to-report recent-delegation [hs]
  report recent-task-mean hs [record -> record-delegation record]
end

to-report recent-learning [hs]
  report recent-task-mean hs [record -> record-learning record]
end

to-report recent-erosion [hs]
  report recent-task-mean hs [record -> record-erosion record]
end

to-report skill-sd [hs]
  if count hs <= 1 [ report 0 ]
  report standard-deviation [skill] of hs
end

to-report delegation-sd [hs]
  let eligible hs with [n-tasks > 0]
  if count eligible <= 1 [ report false ]
  report standard-deviation [sum-deleg / n-tasks] of eligible
end

to-report percent-skill-loss [hs threshold]
  if not any? hs [ report 0 ]
  report 100 * count hs with [skill < initial-skill - threshold] / count hs
end

;; Snapshot plots use isolated randomness so drawing does not consume model draws.
to plot-individual-skill
  if ticks mod 10 != 0 [ stop ]
  with-local-randomness [
    clear-plot
    set-current-plot-pen "No change"
    plotxy 0 0
    plotxy 100 100
    foreach (sort humans) [person ->
      let group [skill-group] of person
      set-current-plot-pen item group ["Low" "Middle" "High"]
      plotxy [initial-skill] of person [skill] of person
    ]
  ]
end

;; Each point is one human; completed-task delegation is averaged per human.
;; This graph shows association, not a causal estimate of delegation's effect.
to plot-delegation-skill-change
  if ticks mod 10 != 0 [ stop ]
  with-local-randomness [
    clear-plot
    set-current-plot-pen "No skill change"
    plotxy 0 0
    plotxy 100 0
    foreach (sort humans) [person ->
      if [n-tasks] of person > 0 [
        set-current-plot-pen item ([skill-group] of person) ["Low" "Middle" "High"]
        plotxy ([100 * sum-deleg / n-tasks] of person) ([skill - initial-skill] of person)
      ]
    ]
  ]
end

to-report recent-net-learning
  let learning recent-learning humans
  let erosion recent-erosion humans
  if not is-number? learning or not is-number? erosion [ report false ]
  report learning - erosion
end

to-report mean-benchmark-change [difficulty]
  let index position difficulty benchmark-difficulties
  report mean [(quality-curve skill difficulty) - item index bench-start] of humans
end

to-report recent-delegation-percent
  let value-now recent-delegation humans
  if not is-number? value-now [ report false ]
  report 100 * value-now
end

;; One dot per human with completed tasks; cumulative delegation, not recent use.
to plot-initial-skill-delegation
  if ticks mod 10 != 0 [ stop ]
  with-local-randomness [
    clear-plot
    foreach (sort humans) [person ->
      if [n-tasks] of person > 0 [
        set-current-plot-pen item ([skill-group] of person) ["Low" "Middle" "High"]
        plotxy ([initial-skill] of person) ([100 * sum-deleg / n-tasks] of person)
      ]
    ]
  ]
end

;; Matched current performance potential on the slider difficulty.
;; Both alternatives use the same humans, current skills and task difficulty.
;; Current task choices determine assisted shares; no states are updated.
to plot-performance-comparison
  if ticks mod 10 != 0 [ stop ]
  let unaided-scores []
  let assisted-scores []
  foreach (sort humans) [person ->
    if [has-task?] of person [
      let human-quality quality-curve ([skill] of person) mu-diff
      let ai-quality quality-curve ai-capability mu-diff
      let delegation [a-chosen] of person
      set unaided-scores lput human-quality unaided-scores
      set assisted-scores lput ((1 - delegation) * human-quality + delegation * ai-quality) assisted-scores
    ]
  ]
  if empty? unaided-scores [ stop ]
  set-current-plot-pen "Without AI"
  plotxy ticks mean unaided-scores
  set-current-plot-pen "With current AI use"
  plotxy ticks mean assisted-scores
end
]]></code>
  <widgets>
    <view x="350" wrappingAllowedX="true" y="10" frameRate="30.0" minPycor="0" height="404" showTickCounter="true" patchSize="40.0" fontSize="10" wrappingAllowedY="true" width="404" tickCounterLabel="ticks" maxPycor="9" updateMode="0" maxPxcor="9" minPxcor="0"></view>
    <button x="125" y="235" height="35" disableUntilTicks="false" forever="false" kind="Observer" width="55" display="Setup">setup</button>
    <button x="195" y="235" height="35" disableUntilTicks="false" forever="true" kind="Observer" width="55" display="Go">go</button>
    <monitor x="780" precision="3" y="10" height="65" fontSize="11" width="220" display="Mean skill">mean-skill</monitor>
    <monitor x="1010" precision="3" y="250" height="65" fontSize="11" width="220" display="Mean completed tasks per human">mean-tasks</monitor>
    <plot x="10" autoPlotX="true" yMax="100.0" autoPlotY="false" yAxis="Skill" y="440" xMin="0.0" height="230" legend="true" xMax="3000.0" yMin="0.0" width="400" xAxis="Ticks" display="Skill by initial tertile">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="Low" color="-2674135" legend="true">
        <setup></setup>
        <update>plot group-mean-skill 0</update>
      </pen>
      <pen interval="1.0" mode="0" display="Medium" color="-10899396" legend="true">
        <setup></setup>
        <update>plot group-mean-skill 1</update>
      </pen>
      <pen interval="1.0" mode="0" display="High" color="-13345367" legend="true">
        <setup></setup>
        <update>plot group-mean-skill 2</update>
      </pen>
    </plot>
    <slider x="10" step="1" y="10" max="100" width="330" display="ai-capability" height="50" min="0" direction="Horizontal" default="70.0" variable="ai-capability"></slider>
    <slider x="10" step="0.01" y="65" max="1" width="330" display="lambda-peer" height="50" min="0" direction="Horizontal" default="0.03" variable="lambda-peer"></slider>
    <slider x="10" step="1" y="120" max="100" width="330" display="mu-skill" height="50" min="0" direction="Horizontal" default="50.0" variable="mu-skill"></slider>
    <slider x="10" step="1" y="175" max="100" width="330" display="mu-diff" height="50" min="0" direction="Horizontal" default="55.0" variable="mu-diff"></slider>
    <monitor x="780" precision="2" y="90" height="65" fontSize="11" width="220" display="Any skill loss (%)">percent-skill-loss humans 0</monitor>
    <monitor x="1010" precision="2" y="90" height="65" fontSize="11" width="220" display="Loss greater than 5 points (%)">percent-skill-loss humans 5</monitor>
    <monitor x="1010" precision="2" y="10" height="65" fontSize="11" width="220" display="Mean skill change">mean [skill - initial-skill] of humans</monitor>
    <monitor x="780" precision="2" y="170" height="65" fontSize="11" width="220" display="Recent delegation (%)">recent-delegation-percent</monitor>
    <monitor x="1010" precision="2" y="170" height="65" fontSize="11" width="220" display="Recent learning minus erosion / task">recent-net-learning</monitor>
    <monitor x="780" precision="2" y="250" height="65" fontSize="11" width="220" display="Unaided score change (difficulty slider)">mean [(quality-curve skill mu-diff) - (quality-curve initial-skill mu-diff)] of humans</monitor>
    <plot x="10" autoPlotX="false" yMax="100.0" autoPlotY="false" yAxis="Average work delegated to AI (%)" y="680" xMin="0.0" height="230" legend="true" xMax="100.0" yMin="0.0" width="400" xAxis="Initial human skill" display="Initial skill versus AI delegation">
      <setup></setup>
      <update>plot-initial-skill-delegation</update>
      <pen interval="1.0" mode="2" display="Low" color="-2674135" legend="true">
        <setup></setup>
        <update></update>
      </pen>
      <pen interval="1.0" mode="2" display="Middle" color="-10899396" legend="true">
        <setup></setup>
        <update></update>
      </pen>
      <pen interval="1.0" mode="2" display="High" color="-13345367" legend="true">
        <setup></setup>
        <update></update>
      </pen>
    </plot>
    <plot x="830" autoPlotX="true" yMax="1.0" autoPlotY="false" yAxis="Delegated share" y="440" xMin="0.0" height="230" legend="true" xMax="3000.0" yMin="0.0" width="400" xAxis="Ticks" display="Recent delegation by tertile (100 ticks)">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="Low" color="-2674135" legend="true">
        <setup></setup>
        <update>if ticks mod 10 = 0 [let value-now (recent-delegation (humans with [skill-group = 0])) if is-number? value-now [plotxy ticks value-now]]</update>
      </pen>
      <pen interval="1.0" mode="0" display="Middle" color="-10899396" legend="true">
        <setup></setup>
        <update>if ticks mod 10 = 0 [let value-now (recent-delegation (humans with [skill-group = 1])) if is-number? value-now [plotxy ticks value-now]]</update>
      </pen>
      <pen interval="1.0" mode="0" display="High" color="-13345367" legend="true">
        <setup></setup>
        <update>if ticks mod 10 = 0 [let value-now (recent-delegation (humans with [skill-group = 2])) if is-number? value-now [plotxy ticks value-now]]</update>
      </pen>
    </plot>
    <plot x="420" autoPlotX="false" yMax="100.0" autoPlotY="false" yAxis="Skill gained (+) or lost (-)" y="680" xMin="0.0" height="230" legend="true" xMax="100.0" yMin="-100.0" width="400" xAxis="Average work delegated to AI (%)" display="AI delegation versus skill change">
      <setup></setup>
      <update>plot-delegation-skill-change</update>
      <pen interval="1.0" mode="0" display="No skill change" color="-7500403" legend="true">
        <setup></setup>
        <update></update>
      </pen>
      <pen interval="1.0" mode="2" display="Low" color="-2674135" legend="true">
        <setup></setup>
        <update></update>
      </pen>
      <pen interval="1.0" mode="2" display="Middle" color="-10899396" legend="true">
        <setup></setup>
        <update></update>
      </pen>
      <pen interval="1.0" mode="2" display="High" color="-13345367" legend="true">
        <setup></setup>
        <update></update>
      </pen>
    </plot>
    <plot x="420" autoPlotX="false" yMax="100.0" autoPlotY="false" yAxis="Current skill" y="440" xMin="0.0" height="230" legend="true" xMax="100.0" yMin="0.0" width="400" xAxis="Initial skill" display="Initial versus current skill">
      <setup></setup>
      <update>plot-individual-skill</update>
      <pen interval="1.0" mode="0" display="No change" color="-7500403" legend="true">
        <setup></setup>
        <update></update>
      </pen>
      <pen interval="1.0" mode="2" display="Low" color="-2674135" legend="true">
        <setup></setup>
        <update></update>
      </pen>
