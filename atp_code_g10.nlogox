<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.4" snapToGrid="true">
  <code><![CDATA[;; Group 10: synchronous task rounds, matching Section 2 of the report.
;; The four sliders are inputs; setup preserves their selected values.
breed [humans human]
;; Display-only turtles hold centred labels; model rules use humans only.
breed [skill-labels skill-label]

globals [
  sd-skill sd-diff perception-skill-sd perception-diff-sd trust-sensitivity
  adjustment-limit alpha-pos alpha-neg learn-rate challenge-width
  scaffold-kappa erosion-rate run-length run-seed
]

humans-own [
  skill initial-skill skill-group trust previous-delegation label-agent
  task-diff chosen-delegation expected-quality actual-quality
  next-skill next-trust learning erosion
  n-tasks sum-deleg recent-delegations recent-net-gains
]

to setup
  no-display
  clear-all
  set run-seed new-seed
  random-seed run-seed
  set-baseline-parameters
  resize-world 0 9 0 9
  ask patches [
    sprout-humans 1 [
      set shape "square"
      set size 0.9
      set skill random-trunc-normal mu-skill sd-skill
      set initial-skill skill
      set trust random-float 100
      set previous-delegation 0.5
      set recent-delegations []
      set recent-net-gains []
    ]
  ]
  ;; Rank once: equal skills are ordered by agent identifier.
  let ranked sort-by [[a b] ->
    ifelse-value ([initial-skill] of a = [initial-skill] of b)
      [[who] of a < [who] of b]
      [[initial-skill] of a < [initial-skill] of b]
  ] humans
  ask humans [set skill-group floor (3 * (position self ranked) / count humans)]
  ;; Create overlays after all humans, preserving their identifiers and random draws.
  with-local-randomness [
    ask humans [
      let owner self
      hatch-skill-labels 1 [
        set size 0
        set label ""
        ask owner [set label-agent myself]
      ]
      update-appearance
    ]
  ]
  reset-ticks
  display
end

to set-baseline-parameters
  set sd-skill 15
  set sd-diff 15
  set perception-skill-sd 1
  set perception-diff-sd 5
  set trust-sensitivity 0.30
  set adjustment-limit 1  ;; one percentage point per round on the integer decision grid
  set alpha-pos 0.10
  set alpha-neg 0.20
  set learn-rate 2
  set challenge-width 25
  set scaffold-kappa 5
  set erosion-rate 1
  set run-length 700
end

to go
  if ticks >= run-length [stop]
  ;; No human sees another human's new state until all outcomes are calculated.
  ask humans [choose-delegation]
  ask humans [calculate-outcome]
  ask humans [commit-outcome]
  tick
end

to choose-delegation
  set task-diff random-trunc-normal mu-diff sd-diff
  let perceived-skill clip (skill + random-normal 0 perception-skill-sd) 0 100
  let perceived-diff clip (task-diff + random-normal 0 perception-diff-sd) 0 100
  let perceived-ai clip (ai-capability + trust-sensitivity * (trust - 50)) 0 100
  let human-quality quality-curve perceived-skill perceived-diff
  let ai-quality quality-curve perceived-ai perceived-diff
  let previous-percent round (100 * previous-delegation)
  let lower-percent max (list 0 (previous-percent - adjustment-limit))
  let upper-percent min (list 100 (previous-percent + adjustment-limit))

  ;; Expected quality is linear in delegation: its maximum is an endpoint,
  ;; or the previous choice when both contributors have equal expected quality.
  let personal-percent previous-percent
  if ai-quality > human-quality [set personal-percent upper-percent]
  if ai-quality < human-quality [set personal-percent lower-percent]
  let mixed-percent personal-percent
  if ticks > 0 [
    let peer-percent 100 * mean [previous-delegation] of (humans-on neighbors)
    set mixed-percent (1 - lambda-peer) * personal-percent + lambda-peer * peer-percent
  ]

  ;; Select the closest feasible grid point. Break ties by distance to previous
  ;; usage, then the lower fraction. Precision removes floating-point tie noise.
  let feasible n-values (upper-percent - lower-percent + 1) [i -> lower-percent + i]
  let nearest-distance min map [a -> precision (abs (a - mixed-percent)) 10] feasible
  let closest filter [a -> precision (abs (a - mixed-percent)) 10 = nearest-distance] feasible
  let previous-distance min map [a -> abs (a - previous-percent)] closest
  set chosen-delegation (min filter [a -> abs (a - previous-percent) = previous-distance] closest) / 100
  set expected-quality (1 - chosen-delegation) * human-quality + chosen-delegation * ai-quality
end

to calculate-outcome
  let a chosen-delegation
  let human-quality quality-curve skill task-diff
  let ai-quality quality-curve ai-capability task-diff
  set actual-quality (1 - a) * human-quality + a * ai-quality
  let surprise (actual-quality - expected-quality) / 100
  set next-trust trust
  ifelse surprise >= 0
    [set next-trust trust + a * alpha-pos * surprise * (100 - trust)]
    [set next-trust trust + a * alpha-neg * surprise * trust]

  let suitability exp (-0.5 * ((task-diff - skill) / challenge-width) ^ 2)
  let practice 1 - a
  let scaffolding scaffold-kappa * a * (1 - a) * ai-quality / 100
  set learning learn-rate * (100 - skill) / 100 * suitability * (practice + scaffolding)
  set erosion erosion-rate * skill / 100 * max (list 0 (2 * a - 1))
  set next-skill clip (skill + learning - erosion) 0 100
end

to commit-outcome
  set skill next-skill
  set trust next-trust
  set previous-delegation chosen-delegation
  set n-tasks n-tasks + 1
  set sum-deleg sum-deleg + chosen-delegation
  ;; Only the latest 100 rounds are needed for the existing recent-value plots.
  set recent-delegations fput chosen-delegation recent-delegations
  set recent-net-gains fput (learning - erosion) recent-net-gains
  if length recent-delegations > 100 [
    set recent-delegations but-last recent-delegations
    set recent-net-gains but-last recent-net-gains
  ]
  update-appearance
end


;; Explicit RGB interpolation: dark navy at 0%, blue at 50%, white at 100%.
;; This avoids NetLogo colour-number wrapping and keeps low-use squares visible.
to update-appearance
  let a previous-delegation
  ifelse a <= 0.5
    [set color (list (12 + 56 * a) (20 + 160 * a) (38 + 344 * a))]
    [set color (list (40 + 430 * (a - 0.5))
                    (100 + 310 * (a - 0.5))
                    (210 + 90 * (a - 0.5)))]
  let change-tenths round ((skill - initial-skill) * 10)
  let magnitude abs change-tenths
  let sign-text ifelse-value (change-tenths < 0) ["-"] ["+"]
  let caption (word sign-text (floor (magnitude / 10)) "." (magnitude mod 10))
  ;; NetLogo right-aligns labels. Offset the zero-size overlay by half the
  ;; text width and height, using the view's 10-point font and patch size.
  let text-width 6 * length caption - 1
  if change-tenths < 0 [set text-width text-width - 4]
  let centre-x xcor
  let centre-y ycor
  ask label-agent [
    set label caption
    set label-color ifelse-value (a > 0.65) [black] [white]
    setxy (centre-x + text-width / (2 * patch-size)) (centre-y - 6.5 / patch-size)
  ]
end

to-report clip [value lower-bound upper-bound]
  report min (list upper-bound (max (list lower-bound value)))
end

to-report random-trunc-normal [centre spread]
  let value random-normal centre spread
  if value < 0 or value > 100 [report random-trunc-normal centre spread]
  report value
end

to-report quality-curve [capability difficulty]
  report clip (50 + capability - difficulty) 0 100
end

;; Summaries weight humans equally. Cumulative delegation is a fraction, not %.
to-report mean-skill
  report mean [skill] of humans
end

to-report mean-tasks
  report mean [n-tasks] of humans
end

to-report mean-delegation
  if not any? humans with [n-tasks > 0] [report 0]
  report mean [sum-deleg / n-tasks] of humans with [n-tasks > 0]
end

to-report group-mean-skill [group-id]
  report mean [skill] of humans with [skill-group = group-id]
end

to-report group-skill-change [group-id]
  report mean [skill - initial-skill] of humans with [skill-group = group-id]
end

to-report group-mean-deleg [group-id]
  let members humans with [skill-group = group-id and n-tasks > 0]
  if not any? members [report 0]
  report mean [sum-deleg / n-tasks] of members
end

to-report percent-skill-loss [members threshold]
  if not any? members [report 0]
  report 100 * count members with [initial-skill - skill > threshold] / count members
end

to-report recent-delegation [members]
  let completed members with [n-tasks > 0]
  if not any? completed [report false]
  report mean [mean recent-delegations] of completed
end

to-report recent-delegation-percent
  let value recent-delegation humans
  if value = false [report false]
  report 100 * value
end

to-report recent-net-learning
  if not any? humans with [n-tasks > 0] [report false]
  report mean [mean recent-net-gains] of humans with [n-tasks > 0]
end

;; Display routines use local randomness so plotting cannot affect the model.
to plot-individual-skill
  if ticks mod 10 != 0 [stop]
  clear-plot
  set-current-plot-pen "No change"
  plotxy 0 0
  plotxy 100 100
  with-local-randomness [
    ask humans [
      set-current-plot-pen item skill-group ["Low" "Middle" "High"]
      plotxy initial-skill skill
    ]
  ]
end

to plot-initial-skill-delegation
  if ticks mod 10 != 0 [stop]
  clear-plot
  with-local-randomness [
    ask humans with [n-tasks > 0] [
      set-current-plot-pen item skill-group ["Low" "Middle" "High"]
      plotxy initial-skill (100 * sum-deleg / n-tasks)
    ]
  ]
end

to plot-delegation-skill-change
  if ticks mod 10 != 0 [stop]
  clear-plot
  set-current-plot-pen "No skill change"
  plotxy 0 0
  plotxy 100 0
  with-local-randomness [
    ask humans with [n-tasks > 0] [
      set-current-plot-pen item skill-group ["Low" "Middle" "High"]
      plotxy (100 * sum-deleg / n-tasks) (skill - initial-skill)
    ]
  ]
end

to plot-performance-comparison
  if ticks mod 10 != 0 [stop]
  with-local-randomness [
    let human-quality mean [quality-curve skill mu-diff] of humans
    let ai-quality quality-curve ai-capability mu-diff
    set-current-plot-pen "0% AI"
    plotxy ticks human-quality
    set-current-plot-pen "50% AI"
    plotxy ticks (0.5 * human-quality + 0.5 * ai-quality)
    set-current-plot-pen "100% AI"
    plotxy ticks ai-quality
  ]
end
]]></code>
  <widgets>
    <view x="350" wrappingAllowedX="true" y="10" frameRate="30.0" minPycor="0" height="404" showTickCounter="true" patchSize="40.0" fontSize="10" wrappingAllowedY="true" width="404" tickCounterLabel="rounds" maxPycor="9" updateMode="0" maxPxcor="9" minPxcor="0"></view>
    <button x="125" y="235" height="35" disableUntilTicks="false" forever="false" kind="Observer" width="55" display="Setup">setup</button>
    <button x="195" y="235" height="35" disableUntilTicks="false" forever="true" kind="Observer" width="55" display="Go">go</button>
    <monitor x="780" precision="3" y="10" height="65" fontSize="11" width="220" display="Mean skill">mean-skill</monitor>
    <plot x="10" autoPlotX="true" yMax="100.0" autoPlotY="false" yAxis="Skill" y="440" xMin="0.0" height="230" legend="true" xMax="700.0" yMin="0.0" width="400" xAxis="Rounds" display="Skill by initial tertile">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="Low" color="-2674135" legend="true">
        <setup></setup>
        <update>plot group-mean-skill 0</update>
      </pen>
      <pen interval="1.0" mode="0" display="Medium" color="-10899396" legend="true">
        <setup></setup>
        <update>plot group-mean-skill 1</update>
      </pen>
      <pen interval="1.0" mode="0" display="High" color="-13345367" legend="true">
