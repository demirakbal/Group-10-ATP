    <plot x="830" autoPlotX="true" yMax="100.0" autoPlotY="false" yAxis="Population mean quality score" y="680" xMin="0.0" height="230" legend="true" xMax="700.0" yMin="0.0" width="400" xAxis="Rounds (difficulty = slider)" display="Quality at 0%, 50%, and 100% AI delegation">
      <setup></setup>
