    <monitor x="780" precision="2" y="90" height="65" fontSize="11" width="220" display="Any skill loss (%)">percent-skill-loss humans 0</monitor>
    <monitor x="1010" precision="2" y="90" height="65" fontSize="11" width="220" display="Loss greater than 5 points (%)">percent-skill-loss humans 5</monitor>
    <monitor x="1010" precision="2" y="10" height="65" fontSize="11" width="220" display="Mean skill change">mean [skill - initial-skill] of humans</monitor>
    <monitor x="780" precision="2" y="170" height="65" fontSize="11" width="220" display="Recent delegation (%)">recent-delegation-percent</monitor>
